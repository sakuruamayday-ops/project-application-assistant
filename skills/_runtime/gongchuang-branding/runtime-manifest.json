{
  "name": "gongchuang-branding-runtime",
  "version": "1.1.0",
  "formats": [
    "pdf",
    "docx",
    "xlsx",
    "xlsm",
    "html"
  ],
  "policy": {
    "fail_closed": true,
    "one_centered_watermark_per_page": true,
    "uniform_document_size": true,
    "page_specific_opacity": true
  },
  "entrypoints": {
    "brand_pdf": "scripts/pdf_two_pass.py",
    "brand_office": "scripts/office_watermark.py",
    "brand_html": "scripts/html_branding.py",
    "delivery_gate": "scripts/delivery_gate.py"
  }
}
