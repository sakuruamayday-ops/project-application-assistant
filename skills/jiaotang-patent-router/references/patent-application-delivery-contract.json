{
  "schema_version": "patent-application-delivery-contract/v1",
  "contract_id": "jiaotang-patent-application-case-v1",
  "manifest_schema": "patent-case-manifest/v1",
  "milestones": {
    "draft-ready": {
      "required_roles": [
        "task_header",
        "technical_disclosure",
        "search_plan",
        "prior_art_evidence",
        "patent_application_input",
        "patent_application_docx"
      ],
      "allow_anonymized_test_fixture": true
    },
    "fixture": {
      "required_roles": [
        "task_header",
        "technical_disclosure",
        "search_plan",
        "prior_art_evidence",
        "patent_application_input",
        "patent_application_docx",
        "drawing_spec",
        "claim_prior_art_matrix",
        "review_record",
        "review_verification",
        "preexam_recommendation",
        "submission_checklist"
      ],
      "allow_anonymized_test_fixture": true
    },
    "filing-ready": {
      "required_roles": [
        "task_header",
        "technical_disclosure",
        "search_plan",
        "prior_art_evidence",
        "patent_application_input",
        "patent_application_docx",
        "drawing_spec",
        "claim_prior_art_matrix",
        "review_record",
        "review_verification",
        "preexam_recommendation",
        "submission_checklist"
      ],
      "allow_anonymized_test_fixture": false
    }
  },
  "roles": {
    "task_header": {
      "stage": "P0",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": []
    },
    "technical_disclosure": {
      "stage": "P2",
      "formats": ["md", "json", "docx"],
      "requires_current_revision": true,
      "depends_on": ["task_header"]
    },
    "search_plan": {
      "stage": "P1",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": ["task_header", "technical_disclosure"]
    },
    "prior_art_evidence": {
      "stage": "P1",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": ["search_plan"]
    },
    "patent_application_input": {
      "stage": "P2",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": [
        "technical_disclosure",
        "search_plan",
        "prior_art_evidence"
      ]
    },
    "patent_application_docx": {
      "stage": "P2",
      "formats": ["docx"],
      "requires_current_revision": true,
      "depends_on": ["patent_application_input"]
    },
    "drawing_spec": {
      "stage": "P2",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": ["patent_application_input", "patent_application_docx"]
    },
    "claim_prior_art_matrix": {
      "stage": "P1",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": ["patent_application_docx", "prior_art_evidence"]
    },
    "review_record": {
      "stage": "B",
      "formats": ["json", "docx"],
      "requires_current_revision": true,
      "depends_on": ["patent_application_docx", "claim_prior_art_matrix"]
    },
    "review_verification": {
      "stage": "B",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": ["patent_application_docx", "review_record"]
    },
    "preexam_recommendation": {
      "stage": "P3",
      "formats": ["json"],
      "requires_current_revision": true,
      "depends_on": ["task_header", "patent_application_docx"]
    },
    "submission_checklist": {
      "stage": "P4",
      "formats": ["md", "json"],
      "requires_current_revision": true,
      "depends_on": [
        "task_header",
        "technical_disclosure",
        "search_plan",
        "prior_art_evidence",
        "patent_application_input",
        "patent_application_docx",
        "drawing_spec",
        "claim_prior_art_matrix",
        "review_record",
        "review_verification",
        "preexam_recommendation"
      ]
    }
  }
}
