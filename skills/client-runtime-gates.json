        "run-input-policy"
      ]
    },
    {
      "point": "skill-activation",
      "blocking": true,
      "requirements": [
        "observe-tool-and-user-explicit-invocation",
        "register-every-activated-skill-in-turn-state",
        "reject-unverified-skill-body",
        "accumulate-multiple-skills",
        "expand-signed-requires-and-quality-gate-relations",
        "bind-professional-contract-version-to-suite-version"
      ]
    },
    {
      "point": "tool-pre-execute",
      "blocking": true,
      "requirements": [
        "enforce-workspace-allowlist",
        "enforce-network-allowlist",
        "enforce-command-and-browser-policy",
        "deny-unregistered-bypass-path"
      ]
    },
    {
      "point": "tool-post-execute",
      "blocking": true,
      "requirements": [
        "append-verifiable-receipt",
        "mark-failed-or-partial-outcome",
        "do-not-upgrade-failure-to-success"
      ]
    },
    {
      "point": "turn-stopping",
      "blocking": true,
      "requirements": [
        "run-delivery-gates-for-all-active-skills",
        "reject-missing-required-skill-or-contract-ordered-section",
        "reject-evidence-boundary-or-quality-gate-omission",
        "require-current-turn-receipts",
        "force-continuation-on-failure",
        "cap-continuation-loop-with-human-visible-block"
      ]
    },
    {
      "point": "turn-end",
      "blocking": false,
      "requirements": [
        "seal-turn-receipt",
        "clear-transient-state",
        "retain-audit-log"
      ]
    }
  ],
  "mandatory_regressions": [
    "first-request-waits-for-session-start",
