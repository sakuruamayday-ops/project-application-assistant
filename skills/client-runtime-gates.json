      "apply-domain-writing-skill",
      "apply-gongchuang-humanizer-zh",
      "rerun-consistency-check"
    ],
    "failure_behavior": "block-current-turn-and-show-missing-skill-structure-evidence-or-receipt"
  },
  "enforcement_components": [
    {
      "component": "signed-desktop-host",
      "responsibility": [
        "verify-runtime-and-policy-signatures-before-dsh-start",
        "lock-controlled-cordis-profile",
        "start-last-known-good-runtime-or-refuse-start"
      ]
    },
    {
      "component": "native-cordis-policy-gate",
      "responsibility": [
        "initialize-policy-synchronously-before-agent-admission",
        "use-awaited-agent-pre-step-for-first-request-gating",
        "enforce-prompt-tool-and-stop-decisions",
        "fail-closed-on-timeout-crash-or-invalid-decision"
      ]
    },
    {
      "component": "central-tool-broker",
      "responsibility": [
        "force-every-model-visible-tool-through-one-pre-and-post-execute-path",
        "deny-direct-network-process-filesystem-or-browser-bypass",
        "apply-workspace-domain-command-and-plugin-allowlists"
