        "verify-suite-manifest-signature",
        "verify-gate-plugin-digest",
        "load-last-known-good-policy"
      ]
    },
    {
      "point": "session-start",
      "blocking": true,
      "requirements": [
        "do-not-rely-on-detached-dsh-session-start-for-first-request",
        "initialize-session-state-before-first-awaited-agent-pre-step",
        "bind-suite-version",
        "record-policy-snapshot"
      ]
    },
    {
      "point": "user-prompt-submit",
      "blocking": true,
      "requirements": [
