{
  "schema_version": 1,
  "product": "共创研究院企业全生命周期助手",
  "release": {
    "tag": "V1.6.4.1",
    "version": "1.6.4.1",
    "summary": "V1.6.4.1 新增统一的前期评估政策申报路径合同，要求企业前期评估与培育报告完整保留相关政策梯度，并以十二字段路径卡呈现能力建设、前置条件、申报节点、主管部门和材料闭环。",
    "changes": [
      "新增前期评估政策路径总闸门，所有企业前期评估、培育规划、多项目矩阵和年度路线图必须先形成与企业相关的完整政策项目池。",
      "统一合同同步到 project-matching、project-feasibility、sme-score-preassessment 和 sme-development-projects，研发机构、绿色工厂、数字化、知识产权和质量品牌等相关路径不得因当前不具备、暂不需要或优先级低而删除。",
      "每个相关项目强制使用十二字段路径卡，覆盖政策状态、企业起点、能力建设、梯度依赖、申报节点、主管部门、证据材料、停项与重启条件及责任动作。",
      "新增正常、边界和拒绝案例及交付自检，目标年度通知未发布时只按规划参考处理，并设置当期通知发布后的整体重检节点。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "V1.6.4.1 同步发布 macOS 与 Windows WorkBuddy 包；外部企业数字身份证和知识索引仍由服务端单独管理，不属于插件包输入。",
      "non_workbuddy_manual_mcp": "其他兼容 Agent 从手工配置页复制已填入个人 Token 的完整远程 MCP 配置。",
      "verification": "确认套件清单声明的全部 Skills 可识别、本地与正式技能清单无未登记漂移、Windows 原生 Hook 生成 schema 4 回执、Grounded 正式交付产生非空 validator_receipts，并完成真实文件结构验收。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "正式发布",
        "note": "包含高企 RD 核心技术及创新点批量回填、企业能力校准、Grounded 算法、注册表、调用图、方向卡规则和专利规则；通用 Skills 包已完成结构与安装门禁。"
      },
      {
        "target": "macOS WorkBuddy",
        "status": "结构兼容，发布后补充实机结果",
        "note": "增加受限的 SessionStart 冷启动恢复并保留原生 UserPromptSubmit 路径；确定性回归通过后仍须完成两个独立真实任务的原始 Hook 与 Stop 回执。"
      },
      {
        "target": "Windows WorkBuddy",
        "status": "结构兼容，发布后补充实机结果",
        "note": "Windows 原生 EXE 已修复生命周期命令根路径，并增加受限 Skill 激活转录恢复、消息事件去重、跨轮 Skill 隔离与 Stop 会话对齐收据；确定性回归通过后仍须由 Windows 真实宿主验证。"
      }
    ],
    "one_step_installation_protocol": {
      "scope": "workbuddy_only",
      "copy_paste_rounds": 1,
      "personal_token_prefilled": true,
      "mcp_configuration_mode": "user_remote_streamable_http",
      "preserve_other_mcp_servers": true,
      "reload_count": 1,
      "success_gate": [
        "套件清单声明的全部 Skills 可识别",
        "最小行为 Hook 已启用",
        "tools/list 枚举 knowledge_search、knowledge_document、knowledge_service_status",
        "knowledge_service_status 返回 connected: true",
        "其他 MCP 条目未被覆盖",
        "安装后只保留一个 V1.6.4.1 活动正式市场，旧版本可恢复快照不覆盖用户资料",
        "安装前原包只读平台预检通过且 package_mutated=false"
      ],
      "released_adapters": [
        "workbuddy-macos",
        "workbuddy-windows"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "WorkBuddy 安装或升级失败时从 plugins 之外的回滚快照恢复原插件目录和用户 MCP 配置；不覆盖其他 MCP 条目。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
  "engine": "skills/evidence-ledger/scripts/grounded_evidence.py",
  "profiles": {
    "chat": {
      "artifacts": [
        "chat"
      ],
      "body_citations": "inline-or-before",
      "source_placement": "selectable",
      "sidecar": false
    },
    "analysis-report": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "end-section",
      "source_title": "数据来源",
      "sidecar": false
    },
    "spreadsheet-native": {
      "artifacts": [
        "xlsx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-worksheet",
      "source_title": "数据来源",
      "sidecar": false
    },
    "presentation-native": {
      "artifacts": [
        "pptx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-slide",
      "source_title": "数据来源",
      "sidecar": false
    },
    "application-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf",
        "xlsx"
      ],
      "body_citations": "native-fields-or-sidecar",
      "source_placement": "template-aware",
      "source_title": "来源说明",
      "sidecar": true
    },
    "standard-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "none",
      "source_placement": "separate-source-memo",
      "source_title": "标准数据来源说明",
      "sidecar": true,
      "forbidden_primary_headings": [
        "数据来源",
        "参考资料"
      ],
      "preserve_primary_headings": [
        "规范性引用文件"
      ]
    }
  },
  "artifact_profile_overrides": {
    "xlsx": "spreadsheet-native",
    "pptx": "presentation-native"
  },
  "artifact_validation": {
    "pdf": {
      "required": [
        "reopen",
        "text-extraction",
        "all-pages-render",
        "nonblank-pages",
        "missing-glyph-scan"
      ],
      "font_rule": "embed-cjk-font-or-use-host-native-export",
      "fail_closed": true
    },
    "docx": {
      "required": [
        "reopen",
        "structure-check",
        "host-render-when-available",
        "missing-glyph-scan"
      ],
      "renderer_missing_cjk_is": "pending-device-acceptance",
      "formal_release_requires_host_render": true
    },
    "xlsx": {
      "required": [
        "reopen",
        "sheet-order",
        "formula-check",
        "all-sheets-render"
      ],
      "renderer": "spreadsheet-native",
      "fail_closed": true
    },
    "pptx": {
      "required": [
        "reopen",
        "slide-order",
        "all-slides-render",
        "overflow-check"
      ],
      "fail_closed": true
    }
  },
  "host_adapters": {
    "codex": "_runtime/grounded-citations/codex_adapter.py",
    "workbuddy": "_runtime/grounded-citations/workbuddy_adapter.py"
  },
