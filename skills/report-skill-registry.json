{
  "schema_version": 1,
  "product": "共创研究院企业全生命周期助手",
  "release": {
    "tag": "V1.6.17",
    "version": "1.6.17",
    "summary": "V1.6.17 完善任务指令、通用运行时、文档读取、专业交付有界收束和独立客户端同源技能投影。",
    "changes": [
      "文档读取按真实内容类型处理常见 Word、Excel、演示文稿、WPS 兼容格式、PDF、ODF、RTF 和文本格式，并逐页报告 OCR 缺口。",
      "专业交付校验最多自动修正一次；仍不满足时形成待完善、等待用户或失败终态，保留已有内容和可执行缺口，不再强制无限续跑。",
      "修正高企研发文案回填、产业目录命中统计、双报告模板分页与字体嵌入，并补齐相应确定性测试。",
      "首次配置改为读取当前运行时实际能力，不再要求安装特定第三方宿主，也不重复安装已有文档与联网能力。",
      "任务沿用用户当前选择的模型与推理档位；既有授权范围内直接执行，高影响缺口只暂停依赖部分。",
      "通用运行时按宿主提供的技能实际路径执行；签名与发布者指纹异常继续硬失败，辅助偏好异常只降级受影响能力。",
      "自动记录、归档与持久化授权分离，未获授权时不写入长期记忆或用户资料目录。",
      "通用签名包与独立客户端内嵌投影使用同一有效技能清单，技能数量由验签清单派生。",
      "V1.6.17 继承 V1.6.16 的绿色工厂版本识别、硬门槛、评分证据矩阵和指标一致性校验。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用签名通用 Skills 包；首次使用时按本轮实际能力执行最小配置。",
      "first_party_client": "共创独立客户端内嵌同一验签技能投影，并由客户端连接管理处理外部服务。",
      "manual_mcp": "其他兼容 Agent 从手工配置页复制已填入个人 Token 的完整远程 MCP 配置。",
      "verification": "确认套件清单声明的全部 Skills 可识别、本地与正式技能清单无未登记漂移、共创客户端生成专业候选与正式交付当前轮回执、Grounded 正式交付产生非空 validator_receipts，并完成真实文件结构验收。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "正式发布",
        "note": "继承 V1.6.16 正式能力；V1.6.17 通用签名包完成源码、模板、签名和隔离安装门禁。"
      },
      {
        "target": "共创独立客户端",
        "status": "发布门禁已定义，双端正式发布单独验收",
        "note": "客户端按当前 DeepSeek Harness 基座演进；必须由签名宿主验证内嵌技能与运行时，并取得目标平台候选、服务器发布和真实安装回执。"
      }
    ],
    "distribution_protocol": {
      "generic_skill_package": "signed-universal-zip",
      "first_party_client": "bundled-signed-skill-suite",
      "platform_specific_package": false,
      "external_service_setup": "skills-center-install-and-connect",
      "success_gate": [
        "套件清单声明的全部 Skills 可识别并与签名索引一致",
        "共创客户端只从已验签 V1.6.17 技能目录加载本次候选 Skills",
        "专业任务必须激活命中技能、依赖技能和质量门禁技能",
        "外部 MCP 只有完成 OAuth 或令牌交换、tools/list 和健康调用后才显示已连接",
        "其他兼容 Agent 只下载同一通用 Skills 包并按标准 Streamable HTTP 配置 MCP"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "共创客户端升级失败时恢复上一签名客户端、上一签名技能包和原 MCP 配置；不覆盖用户企业资料或第三方连接。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
  "engine": "skills/evidence-ledger/scripts/grounded_evidence.py",
  "profiles": {
    "chat": {
      "artifacts": [
        "chat"
      ],
      "body_citations": "inline-or-before",
      "source_placement": "selectable",
      "sidecar": false
    },
    "analysis-report": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "end-section",
      "source_title": "数据来源",
      "sidecar": false
    },
    "spreadsheet-native": {
      "artifacts": [
        "xlsx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-worksheet",
      "source_title": "数据来源",
      "sidecar": false
    },
    "presentation-native": {
      "artifacts": [
        "pptx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-slide",
      "source_title": "数据来源",
      "sidecar": false
    },
    "application-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf",
        "xlsx"
      ],
      "body_citations": "native-fields-or-sidecar",
      "source_placement": "template-aware",
      "source_title": "来源说明",
      "sidecar": true
    },
    "standard-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "none",
      "source_placement": "separate-source-memo",
      "source_title": "标准数据来源说明",
      "sidecar": true,
      "forbidden_primary_headings": [
        "数据来源",
        "参考资料"
      ],
      "preserve_primary_headings": [
        "规范性引用文件"
      ]
    }
  },
  "artifact_profile_overrides": {
    "xlsx": "spreadsheet-native",
    "pptx": "presentation-native"
  },
  "artifact_validation": {
    "pdf": {
      "required": [
        "reopen",
        "text-extraction",
        "all-pages-render",
        "nonblank-pages",
        "missing-glyph-scan"
      ],
      "font_rule": "embed-cjk-font-or-use-host-native-export",
      "fail_closed": true
    },
    "docx": {
      "required": [
        "reopen",
        "structure-check",
        "host-render-when-available",
        "missing-glyph-scan"
      ],
      "renderer_missing_cjk_is": "pending-device-acceptance",
      "formal_release_requires_host_render": true
    },
    "xlsx": {
      "required": [
        "reopen",
        "sheet-order",
        "formula-check",
        "all-sheets-render"
      ],
      "renderer": "spreadsheet-native",
      "fail_closed": true
    },
    "pptx": {
      "required": [
        "reopen",
        "slide-order",
        "all-slides-render",
        "overflow-check"
      ],
      "fail_closed": true
    }
  },
  "host_adapters": {
    "codex": "_runtime/grounded-citations/codex_adapter.py",
    "first_party_client": "_runtime/grounded-citations/first_party_client_adapter.py"
  },
