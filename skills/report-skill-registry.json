{
  "schema_version": 1,
  "product": "共创研究院企业全生命周期助手",
  "release": {
    "tag": "V1.6.13",
    "version": "1.6.13",
    "summary": "V1.6.13 修复 XLSX 工作表关系、稀疏单元格和百分比显示值提取，避免表格证据错列或失真。",
    "changes": [
      "XLSX 按工作簿关系映射解析实际工作表文件，不再假设 sheet1.xml、sheet2.xml 与界面顺序相同。",
      "XLSX 按单元格坐标恢复空列和稀疏行，避免缺省单元格导致后续字段整体左移。",
      "XLSX 解析 styles.xml 的百分比数字格式，以用户可见的百分比文本进入证据链。",
      "V1.6.13 继承 V1.6.12 的深度澄清收敛、三档回答深度、Word 默认交付、文档操作、证据合同、共创精选、本地知识库优先路由与共创客户端专业执行合同。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "V1.6.13 同步提供 macOS 与 Windows 平台专用包；平台包只包含 Skills、最小行为 Hook 和远程知识服务配置，不携带用户凭据或本地 MCP。",
      "non_workbuddy_manual_mcp": "其他兼容 Agent 从手工配置页复制已填入个人 Token 的完整远程 MCP 配置。",
      "verification": "确认套件清单声明的全部 Skills 可识别、本地与正式技能清单无未登记漂移、共创客户端生成专业候选与正式交付当前轮回执、Grounded 正式交付产生非空 validator_receipts，并完成真实文件结构验收。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "正式发布",
        "note": "继承 V1.6.9 全部正式能力；新增三档回答深度并继续执行结构、依赖、签名和安装门禁。"
      },
      {
        "target": "macOS 平台专用包",
        "status": "结构兼容，正式包待实机回执",
        "note": "使用 Bash 适配器与共享 Python 状态核心，按完整技能识别、最小行为 Hook、远程知识服务和真实交付回执执行发布门禁。"
      },
      {
        "target": "Windows 平台专用包",
        "status": "结构兼容，正式包待实机回执",
        "note": "仅包含固定 Go 工具链复构建的原生 EXE Hook，不携带 PowerShell、CMD、Python Hook 核心或用户凭据。"
      },
      {
        "target": "共创独立客户端",
        "status": "发布门禁已定义，双端正式发布单独验收",
        "note": "固定 DeepSeek Harness 0.1.1-rc.2 上游提交 b150a551b8d465e31e418e1b2eaf5e79bbb7d28e；必须由签名宿主插件失败关闭执行完整 Hook 生命周期，并取得 macOS 双架构候选、服务器发布和真实安装回执。"
      }
    ],
    "distribution_protocol": {
      "generic_skill_package": "signed-universal-zip",
      "first_party_client": "bundled-signed-skill-suite",
      "workbuddy_specific_package": true,
      "external_service_setup": "skills-center-install-and-connect",
      "success_gate": [
        "套件清单声明的全部 Skills 可识别并与签名索引一致",
        "共创客户端只从已验签 V1.6.13 技能目录加载正式 Skills",
        "专业任务必须激活命中技能、依赖技能和质量门禁技能",
        "外部 MCP 只有完成 OAuth 或令牌交换、tools/list 和健康调用后才显示已连接",
        "macOS 与 Windows 平台包分别通过运行时隔离、完整技能覆盖和服务端发布合同门禁",
        "其他兼容 Agent 只下载同一通用 Skills 包并按标准 Streamable HTTP 配置 MCP"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "共创客户端升级失败时恢复上一签名客户端、上一签名技能包和原 MCP 配置；不覆盖用户企业资料或第三方连接。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
  "engine": "skills/evidence-ledger/scripts/grounded_evidence.py",
  "profiles": {
    "chat": {
      "artifacts": [
        "chat"
      ],
      "body_citations": "inline-or-before",
      "source_placement": "selectable",
      "sidecar": false
    },
    "analysis-report": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "end-section",
      "source_title": "数据来源",
      "sidecar": false
    },
    "spreadsheet-native": {
      "artifacts": [
        "xlsx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-worksheet",
      "source_title": "数据来源",
      "sidecar": false
    },
    "presentation-native": {
      "artifacts": [
        "pptx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-slide",
      "source_title": "数据来源",
      "sidecar": false
    },
    "application-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf",
        "xlsx"
      ],
      "body_citations": "native-fields-or-sidecar",
      "source_placement": "template-aware",
      "source_title": "来源说明",
      "sidecar": true
    },
    "standard-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "none",
      "source_placement": "separate-source-memo",
      "source_title": "标准数据来源说明",
      "sidecar": true,
      "forbidden_primary_headings": [
        "数据来源",
        "参考资料"
      ],
      "preserve_primary_headings": [
        "规范性引用文件"
      ]
    }
  },
  "artifact_profile_overrides": {
    "xlsx": "spreadsheet-native",
    "pptx": "presentation-native"
  },
  "artifact_validation": {
    "pdf": {
      "required": [
        "reopen",
        "text-extraction",
        "all-pages-render",
        "nonblank-pages",
        "missing-glyph-scan"
      ],
      "font_rule": "embed-cjk-font-or-use-host-native-export",
      "fail_closed": true
    },
    "docx": {
      "required": [
        "reopen",
        "structure-check",
        "host-render-when-available",
        "missing-glyph-scan"
      ],
      "renderer_missing_cjk_is": "pending-device-acceptance",
      "formal_release_requires_host_render": true
    },
    "xlsx": {
      "required": [
        "reopen",
        "sheet-order",
        "formula-check",
        "all-sheets-render"
      ],
      "renderer": "spreadsheet-native",
      "fail_closed": true
    },
    "pptx": {
      "required": [
        "reopen",
        "slide-order",
        "all-slides-render",
        "overflow-check"
      ],
      "fail_closed": true
    }
  },
  "host_adapters": {
    "codex": "_runtime/grounded-citations/codex_adapter.py",
    "workbuddy": "_runtime/grounded-citations/workbuddy_adapter.py"
  },
