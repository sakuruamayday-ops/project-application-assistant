{
  "schema_version": 1,
  "product": "共创研究院企业全生命周期助手",
  "release": {
    "tag": "V1.6.7",
    "version": "1.6.7",
    "summary": "V1.6.7 汇总未发布的 V1.6.6 共创精选与专业报告能力，修复最简报告提示词与本地知识库优先路由，并新增面向复杂任务的深度澄清能力。",
    "changes": [
      "企业名称加现有资料即可启动十二类项目前期评估或可行性分析；主体缺口按天眼查、企查查和官方来源补齐，无法核验字段如实标为待核验。",
      "高企、专精特新和小巨人等常用短提示词进入专业报告路由，普通“给朋友出报告”等非专业对话不误触发。",
      "同行及获评企业检索固定本地知识库 → 天眼查 → 企查查 → 官方网页或联网搜索，禁止首步直接联网。",
      "新增深度澄清：复杂、歧义或正式交付任务可按依赖分轮确认；普通任务不误触发，未形成共同理解并经用户确认前不得实施。",
      "V1.6.7 汇总 V1.6.6 的共创精选、国知局专利首轮发现、十二类双报告母版和共创客户端专业执行合同，只发布签名通用 Skills 包。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "V1.6.7 不再发布 macOS 或 Windows WorkBuddy 专用包。WorkBuddy 历史适配代码只保留为兼容性资料，不进入正式资产、发布门禁或安装入口。",
      "non_workbuddy_manual_mcp": "其他兼容 Agent 从手工配置页复制已填入个人 Token 的完整远程 MCP 配置。",
      "verification": "确认套件清单声明的全部 Skills 可识别、本地与正式技能清单无未登记漂移、共创客户端生成专业候选与正式交付当前轮回执、Grounded 正式交付产生非空 validator_receipts，并完成真实文件结构验收。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "正式发布",
        "note": "包含 V1.6.5.2 全部正式能力和 V1.6.6 候选中的共创精选、国知局首轮发现、十二类双报告与客户端合同，并新增最简报告提示词和本地知识库优先同行检索；通用 Skills 包继续执行结构、依赖、签名和安装门禁。"
      },
      {
        "target": "macOS WorkBuddy",
        "status": "不再发布专用包",
        "note": "历史兼容实现保留在源码中供审计与迁移参考，但 V1.6.7 正式资产不包含 WorkBuddy 包、安装指令或专用 Hook。"
      },
      {
        "target": "Windows WorkBuddy",
        "status": "不再发布专用包",
        "note": "历史兼容实现保留在源码中供审计与迁移参考，但 V1.6.7 正式资产不包含 WorkBuddy 包、安装指令或 Windows 专用 Hook。"
      },
      {
        "target": "共创独立客户端",
        "status": "发布门禁已定义，双端正式发布单独验收",
        "note": "固定 DeepSeek Harness 0.1.0-rc.8 上游提交 141eb6fef83422698aef7a981029e843e8161531；必须由签名宿主插件失败关闭执行完整 Hook 生命周期，并取得 macOS 公证、Windows Authenticode、全新设备安装、升级和回滚回执。"
      }
    ],
    "distribution_protocol": {
      "generic_skill_package": "signed-universal-zip",
      "first_party_client": "bundled-signed-skill-suite",
      "workbuddy_specific_package": false,
      "external_service_setup": "skills-center-install-and-connect",
      "success_gate": [
        "套件清单声明的全部 Skills 可识别并与签名索引一致",
        "共创客户端只从已验签 V1.6.7 技能目录加载正式 Skills",
        "专业任务必须激活命中技能、依赖技能和质量门禁技能",
        "外部 MCP 只有完成 OAuth 或令牌交换、tools/list 和健康调用后才显示已连接",
        "其他兼容 Agent 只下载同一通用 Skills 包并按标准 Streamable HTTP 配置 MCP"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "共创客户端升级失败时恢复上一签名客户端、上一签名技能包和原 MCP 配置；不覆盖用户企业资料或第三方连接。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
  "engine": "skills/evidence-ledger/scripts/grounded_evidence.py",
  "profiles": {
    "chat": {
      "artifacts": [
        "chat"
      ],
      "body_citations": "inline-or-before",
      "source_placement": "selectable",
      "sidecar": false
    },
    "analysis-report": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "end-section",
      "source_title": "数据来源",
      "sidecar": false
    },
    "spreadsheet-native": {
      "artifacts": [
        "xlsx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-worksheet",
      "source_title": "数据来源",
      "sidecar": false
    },
    "presentation-native": {
      "artifacts": [
        "pptx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-slide",
      "source_title": "数据来源",
      "sidecar": false
    },
    "application-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf",
        "xlsx"
      ],
      "body_citations": "native-fields-or-sidecar",
      "source_placement": "template-aware",
      "source_title": "来源说明",
      "sidecar": true
    },
    "standard-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "none",
      "source_placement": "separate-source-memo",
      "source_title": "标准数据来源说明",
      "sidecar": true,
      "forbidden_primary_headings": [
        "数据来源",
        "参考资料"
      ],
      "preserve_primary_headings": [
        "规范性引用文件"
      ]
    }
  },
  "artifact_profile_overrides": {
    "xlsx": "spreadsheet-native",
    "pptx": "presentation-native"
  },
  "artifact_validation": {
    "pdf": {
      "required": [
        "reopen",
        "text-extraction",
        "all-pages-render",
        "nonblank-pages",
        "missing-glyph-scan"
      ],
      "font_rule": "embed-cjk-font-or-use-host-native-export",
      "fail_closed": true
    },
    "docx": {
      "required": [
        "reopen",
        "structure-check",
        "host-render-when-available",
        "missing-glyph-scan"
      ],
      "renderer_missing_cjk_is": "pending-device-acceptance",
      "formal_release_requires_host_render": true
    },
    "xlsx": {
      "required": [
        "reopen",
        "sheet-order",
        "formula-check",
        "all-sheets-render"
      ],
      "renderer": "spreadsheet-native",
      "fail_closed": true
    },
    "pptx": {
      "required": [
        "reopen",
        "slide-order",
        "all-slides-render",
        "overflow-check"
      ],
      "fail_closed": true
    }
  },
  "host_adapters": {
    "codex": "_runtime/grounded-citations/codex_adapter.py",
    "workbuddy": "_runtime/grounded-citations/workbuddy_adapter.py"
  },
