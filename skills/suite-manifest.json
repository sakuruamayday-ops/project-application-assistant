{
  "schema_version": 1,
  "product_name": "企业全生命周期助手",
  "product_slug": "jiaotang-skills",
  "install_mode": "bundle-only",
  "release": {
    "tag": "V1.4.7",
    "version": "1.4.7",
    "summary": "V1.4.7 修复 WorkBuddy 原生 Skill 注册与 Hook 闭环，优化发布编排，并完成门户黑金体系收口。",
    "changes": [
      "修复 WorkBuddy 包中行为 Hook 被写到 YAML frontmatter 之前的问题，49 个 SKILL.md 均以合法 frontmatter 开头，name 与目录一一对应且全套唯一。",
      "发布端和门户下载端新增 Skill 原生注册静态门禁，错误前置内容、名称错配、重复名称或 Hook 位置异常都会在正式发布前阻断。",
      "最小行为 Hook 的激活记录绑定 Skill、规则版本、轮次 ID 和时间；正式业务交付零 Skill 激活时返回 NO_ACTIVE_BUSINESS_SKILL，普通问答及 Hook 内部异常仍失败开放。",
      "Hook 会话只保存提示词摘要和契约信号，不再持久化完整用户提示词；算法程序化执行继续保留为后续独立项目。",
      "知识发布固定为索引先发布并切换、应用后部署；复用 Acceptance Harness 收据，统一 manifest 路径，拒绝候选回落到可变 current 目录，并记录逐阶段耗时。",
      "退役独立 Skills Manager、PWA 路由和专属发布流程，网站分发统一回到 Skills 中心与一次复制粘贴安装。",
      "门户删除被黑金主题覆盖的第二套浅色组件 CSS，将仍在使用的规则迁入黑金语义层，并保留桌面与移动端回归门禁。",
      "继续保持 49 项 Skills、用户级远程 HTTP MCP、自动填入个人 Token、只替换 jiaotang-kb、保留其他 MCP 和一次重载的简化安装边界。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "用户在门户复制一段完整指令给 WorkBuddy，一次完成 V1.4.7 插件安装或覆盖升级和远程 MCP 连接。",
      "non_workbuddy_manual_mcp": "其他兼容 Agent 从手工配置页复制已填入个人 Token 的完整远程 MCP 配置。",
      "verification": "确认 49 项 Skills 可识别、tools/list 出现三个核心知识工具，并实际调用 knowledge_service_status 返回 connected: true。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "已验证",
        "note": "适用于能够导入 SKILL.md 的 Agent。"
      },
      {
        "target": "macOS WorkBuddy",
        "status": "跨平台通用包",
        "note": "V1.4.6 双端实机基线已通过；V1.4.7 继续使用用户级远程 HTTP MCP，并新增原生 Skill 注册门禁。"
      },
      {
        "target": "Windows WorkBuddy",
        "status": "结构与 CI 已验证，待发布后实机验收",
        "note": "V1.4.6 双端实机基线已通过；V1.4.7 固定使用 %USERPROFILE%\\.workbuddy\\mcp.json，并修复 Skill frontmatter 与 Hook 激活闭环。"
      }
    ],
    "one_step_installation_protocol": {
      "scope": "workbuddy_only",
      "copy_paste_rounds": 1,
      "personal_token_prefilled": true,
      "mcp_configuration_mode": "user_remote_streamable_http",
      "preserve_other_mcp_servers": true,
      "reload_count": 1,
      "success_gate": [
        "49 项 Skills 可识别",
        "最小行为 Hook 已启用",
        "tools/list 枚举 knowledge_search、knowledge_document、knowledge_service_status",
        "knowledge_service_status 返回 connected: true",
        "其他 MCP 条目未被覆盖"
      ],
      "released_adapters": [
        "workbuddy"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "WorkBuddy 安装或升级失败时恢复原插件目录和用户 MCP 配置备份；不覆盖其他 MCP 条目。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
