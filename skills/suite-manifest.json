  "release_gates": [
    {
      "name": "pytest",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "environment": {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"
      },
      "timeout_seconds": 300
    },
    {
      "name": "adversarial-structure",
      "command": [
        "{python}",
        "tests/validate_adversarial_cases.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "skill-behavior-coverage",
      "command": [
        "{python}",
        "tests/validate_skill_behavior_coverage.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "skill-content-suite",
      "command": [
        "{python}",
        "tests/validate_skill_content_suite.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "deprecated-policy-semantics",
      "command": [
        "{python}",
        "scripts/validate_deprecated_policy_rules.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "single-knowledge-mcp",
      "command": [
        "{python}",
        "tests/validate_single_knowledge_mcp.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "three-first-gold",
      "command": [
        "{python}",
        "tests/validate_three_first_gold.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "workbuddy-one-step-install-contract",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "services/knowledge-portal/tests/test_portal.py::test_v150_one_step_install_reuses_token_cleans_old_versions_and_accepts_bearer_only"
      ],
      "environment": {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
        "PYTHONPATH": "services/knowledge-portal"
      },
      "timeout_seconds": 180
    }
  ],
  "post_package_release_gates": [
    {
      "name": "workbuddy-server-release-candidate-contract",
      "command": [
        "{python}",
        "tests/validate_workbuddy_release_candidate.py",
        "--suite-zip",
        "{workbuddy_archive}",
        "--check",
        "server-release-contract"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "workbuddy-all-skill-package-coverage",
      "command": [
        "{python}",
        "tests/validate_workbuddy_release_candidate.py",
        "--suite-zip",
        "{workbuddy_archive}",
        "--check",
        "all-skill-coverage"
      ],
      "timeout_seconds": 120
    }
  ],
