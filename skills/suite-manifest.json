  "release": {
    "tag": "V1.3.1.2",
    "version": "1.3.1.2",
    "summary": "统一 WorkBuddy 跨平台本地市场包，移除外层固定安装器与运行锁，并保留 bootstrap_url 一键复制。",
    "changes": [
      "macOS 与 Windows 使用同一个 WorkBuddy 本地插件市场 ZIP；包外不再包含 .command、.cmd 或 .ps1 固定安装器。",
      "安装只在正在运行的 WorkBuddy 中通过 /plugin 完成，不调用外部 CLI、不要求退出 WorkBuddy，也不建立运行锁。",
      "API 与用户页、Skills 管理中心的手工配置确认按钮会生成并复制一次性 bootstrap_url；浏览器拒绝剪贴板权限时保留下方手工复制兜底。",
      "本次是同一 Skills 版本的分发方式修复；49 项业务技能内容不变，既有安装、设备绑定、系统凭据与 MCP 接入不受影响。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "下载并验签 V1.3.1.2 跨平台 WorkBuddy ZIP，解压后在 WorkBuddy 中输入 /plugin，添加解压后的 jiaotang 本地市场目录，再安装并启用 jiaotang-workbuddy-skills@jiaotang。",
      "manual_fallback": "从 API 与用户页或 Skills 管理中心完成公开说明审查后，点击生成并复制 bootstrap_url，再粘贴到 WorkBuddy 插件敏感配置。",
      "verification": "安装后必须核对技能清单，并完成身份、检索、文档读取、用量和 MCP 工具调用验收。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "已验证",
        "note": "适用于能够导入 SKILL.md 的 Agent。"
      },
      {
        "target": "macOS WorkBuddy",
        "status": "跨平台通用包",
        "note": "可选使用 V1.3.1.2 通用本地市场包；既有 V1.3.1.1 用户无需强制更新。"
      },
      {
        "target": "Windows WorkBuddy",
        "status": "跨平台通用包",
        "note": "已移除导致端口冲突的外部安装器链路；包结构、签名和逐文件哈希已验证，真实 Windows 宿主仍需发布后按应用内流程复验。"
      }
    ],
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "WorkBuddy 回滚时在插件管理中停用、卸载 jiaotang-workbuddy-skills 并移除 jiaotang 本地市场；需要时重新安装原包。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
