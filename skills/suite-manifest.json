  "release": {
    "tag": "V1.6.5.1",
    "version": "1.6.5.1",
    "summary": "V1.6.5.1 在 V1.6.5 双报告路由基础上内置十二类项目二十四份可编辑 Word 受控母版、自动选版索引与模板哈希闸门，并使 macOS 和 Windows Stop Hook 一致强制报告画像回执。",
    "changes": [
      "新增项目前期评估报告与项目申报可行性分析报告两类正式交付，前者服务谈单，后者逐项拆解现行条件、评分表、证据和补强任务。",
      "高企、专精特新、小巨人、三首、研发中心、制造精品、单项冠军、绿色工厂、数字化及科技计划自动切换项目专属核心评估对象。",
      "所有项目报告建议形成国内产品技术水平评价咨询报告和国际产品技术水平评价咨询报告；证据形成前不得承诺国内领先或国际先进。",
      "专精线新增数字化转型诊断报告补强，核验五个一级维度、全国与同行对标、优势短板及提升路径。",
      "高企新增研发费用加计扣除规范化服务，贯通立项、人员设备、工时领料、小试中试、结题、专利关联、月度分配、辅助账与明细账。",
      "两类报告统一使用共创红色水印并输出可编辑 Word 与 PDF；无法只加密水印且保持正文可编辑时不设置编辑限制。",
      "企业分析报告 A、B、C 版以及尖兵领雁、市级重大和科技计划类既有分析逻辑保持不变。",
      "内置高企、专精特新、小巨人、三首、研发中心、制造精品、单项冠军、绿色工厂、数字化和科技计划二十四份 Word 母版，命中时先选版再回填。",
      "模板索引对项目别名执行最长命中，对未知、冲突、哈希变更或覆盖现有文件一律拒绝。",
      "macOS 与 Windows Stop Hook 一致识别完成交付语义和对象定向否定，并强制当前轮次的章节、表格、Word、PDF、哈希及红色水印验证回执。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "V1.6.5.1 候选包同步提供 macOS 与 Windows WorkBuddy 结构；外部企业数字身份证和知识索引仍由服务端单独管理，不属于插件包输入。",
      "non_workbuddy_manual_mcp": "其他兼容 Agent 从手工配置页复制已填入个人 Token 的完整远程 MCP 配置。",
      "verification": "确认套件清单声明的全部 Skills 可识别、本地与正式技能清单无未登记漂移、Windows 原生 Hook 生成 schema 4 回执、Grounded 正式交付产生非空 validator_receipts，并完成真实文件结构验收。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "正式发布",
        "note": "包含高企 RD 核心技术及创新点批量回填、企业能力校准、汇总表字段粒度校验、WPS逐页验收与哈希闭环，以及 Grounded 算法、注册表、调用图、方向卡规则和专利规则；通用 Skills 包已完成结构与安装门禁。"
      },
      {
        "target": "macOS WorkBuddy",
        "status": "结构兼容，发布后补充实机结果",
        "note": "增加受限的 SessionStart 冷启动恢复并保留原生 UserPromptSubmit 路径；确定性回归通过后仍须完成两个独立真实任务的原始 Hook 与 Stop 回执。"
      },
      {
        "target": "Windows WorkBuddy",
        "status": "结构兼容，发布后补充实机结果",
        "note": "Windows 原生 EXE 已修复生命周期命令根路径，并增加受限 Skill 激活转录恢复、消息事件去重、跨轮 Skill 隔离与 Stop 会话对齐收据；确定性回归通过后仍须由 Windows 真实宿主验证。"
      }
    ],
    "one_step_installation_protocol": {
      "scope": "workbuddy_only",
      "copy_paste_rounds": 1,
      "personal_token_prefilled": true,
      "mcp_configuration_mode": "user_remote_streamable_http",
      "preserve_other_mcp_servers": true,
      "reload_count": 1,
      "success_gate": [
        "套件清单声明的全部 Skills 可识别",
        "最小行为 Hook 已启用",
        "tools/list 枚举 knowledge_search、knowledge_document、knowledge_service_status",
        "knowledge_service_status 返回 connected: true",
        "其他 MCP 条目未被覆盖",
        "安装后只保留一个 V1.6.5.1 活动正式市场，旧版本可恢复快照不覆盖用户资料",
        "安装前原包只读平台预检通过且 package_mutated=false"
      ],
      "released_adapters": [
        "workbuddy-macos",
        "workbuddy-windows"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "WorkBuddy 安装或升级失败时从 plugins 之外的回滚快照恢复原插件目录和用户 MCP 配置；不覆盖其他 MCP 条目。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
