        "non_workbuddy_action": "停留在审查阶段，不得下载或安装 WorkBuddy 插件包"
      },
      "phase_2_install": {
        "explicit_user_confirmation_required": true,
        "pin_reviewed_workbuddy_version_and_sha256": true,
        "dynamic_command_allowed": false,
        "success_gate": [
          "宿主完成原生注册",
          "设备凭据写入系统安全存储并回读",
          "tools/list 枚举真实远端工具",
          "只读工具实际调用成功",
          "门户四阶段状态完成"
        ]
      },
      "released_adapters": [
        "workbuddy"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "WorkBuddy 跨版本升级失败时优先恢复升级前插件目录和原版本包；不删除持久 jiaotang 市场、设备绑定、设备密钥、API Token 或 jiaotang-kb MCP 身份。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
