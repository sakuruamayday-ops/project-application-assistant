{
  "schema_version": 1,
  "product_name": "企业全生命周期助手",
  "product_slug": "jiaotang-skills",
  "install_mode": "bundle-only",
  "release": {
    "tag": "V1.4.3",
    "version": "1.4.3",
    "summary": "V1.4.3 完成技能包、WorkBuddy 插件、发布事务、门户下载与 OSS 索引链路的纵深安全加固，并固化旧政策效力核验的主路由优先级与并行真实宿主门禁；49 项业务 Skills 的主体能力与 V1.4.2 保持一致。",
    "changes": [
      "通用 Skills 与 WorkBuddy 包固定官方 Ed25519 发布者身份，严格校验完整签名文件集和逐文件 SHA-256；验签工具缺失、缓存异常或包被篡改时一律失败关闭。",
      "ZIP 处理拒绝反斜杠、绝对路径、父目录、盘符、NUL、符号链接、重复条目和大小写碰撞；内置秘密扫描支持 Unicode 归一化并递归检查嵌套 ZIP。",
      "安装器在创建回滚副本失败时不再继续替换，升级失败会恢复原目录；证据目录可显式配置，避免测试或受限环境误写用户目录。",
      "发布门禁绑定 Git commit、tree、跟踪源码摘要、套件清单、发布管理器、工具链和最终包哈希；从仓库外启动仍强制检查唯一仓库根目录。",
      "49 项 Skills 均有行为覆盖门禁；WorkBuddy 候选包必须通过真实宿主全技能激活及对抗路由测试，宿主 CLI 缺失计为失败而非跳过。",
      "门户邀请改为一次性原子消费的 v2 令牌，移除姓名加手机号后四位的旧注册链路；登录、注册和问答接口增加可信来源限流与会话敏感信息清理。",
      "自带模型接口限制为 HTTPS、公网地址、受控端口和禁止重定向，并限制响应体、并发和超时；问题明文按 24 小时后台周期清理。",
      "门户下载在入库和发送前同时核验数据库 SHA-256、固定发布者签名及同一稳定文件内容，阻断无效候选包、验签缓存复用和校验后换包。",
      "OSS 索引采用不可变 release、签名 current 指针、条件写入和 current/previous 本地世代；运行健康检查覆盖服务、磁盘、TLS、索引世代与构建身份。",
      "49 项顶层 Skills 的业务规则、路由和交付契约与 V1.4.2 保持不变。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "新设备通过门户两步流程安装 V1.4.3 WorkBuddy 包；插件启用后由 Agent 调用本地 jiaotang_kb_setup 工具完成绑定。已绑定 V1.4.x 设备使用 Skills 中心升级按钮，不重新登记。",
      "manual_fallback": "手工配置只作为自动两步流程的替代路径；核验签名包并启用插件后，仅将一次性 bootstrap_url 作为本地 jiaotang_kb_setup 工具参数。",
      "verification": "门户四阶段完成后还必须确认 jiaotang-kb 已进入当前运行时，成功调用任一只读状态或检索工具，并抽样验证项目算法、交付契约或专利案卷入口；之后升级验收才完成。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "已验证",
        "note": "适用于能够导入 SKILL.md 的 Agent。"
      },
      {
        "target": "macOS WorkBuddy",
