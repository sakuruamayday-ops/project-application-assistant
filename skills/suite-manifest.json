        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_project_report_templates.py",
        "tests/test_project_report_profile_delivery.py",
        "tests/test_project_dual_report_contract_v165.py"
      ],
      "environment": {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"
      },
      "timeout_seconds": 120
    },
    {
      "name": "deprecated-policy-semantics",
      "command": [
        "{python}",
        "scripts/validate_deprecated_policy_rules.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "single-knowledge-mcp",
      "command": [
        "{python}",
        "tests/validate_single_knowledge_mcp.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "three-first-gold",
      "command": [
        "{python}",
        "tests/validate_three_first_gold.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "workbuddy-one-step-install-contract",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "services/knowledge-portal/tests/test_portal.py::test_v150_one_step_install_issues_per_install_token_and_accepts_bearer_only"
      ],
      "environment": {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
        "PYTHONPATH": "services/knowledge-portal"
      },
      "timeout_seconds": 180
    }
  ],
