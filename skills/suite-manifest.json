  "release_gates": [
    {
      "name": "pytest",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "environment": {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"
      },
      "timeout_seconds": 300
    },
    {
      "name": "adversarial-structure",
      "command": [
        "{python}",
        "tests/validate_adversarial_cases.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "skill-behavior-coverage",
      "command": [
        "{python}",
        "tests/validate_skill_behavior_coverage.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "skill-content-suite",
      "command": [
        "{python}",
        "tests/validate_skill_content_suite.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "deprecated-policy-semantics",
      "command": [
        "{python}",
        "scripts/validate_deprecated_policy_rules.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "single-knowledge-mcp",
      "command": [
        "{python}",
        "tests/validate_single_knowledge_mcp.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "three-first-gold",
      "command": [
        "{python}",
        "tests/validate_three_first_gold.py"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "release-companion-contract",
      "command": [
        "{python}",
        "scripts/release_companions.py",
        "--check"
      ],
      "timeout_seconds": 60
    }
  ],
  "post_package_release_gates": [
    {
      "name": "real-workbuddy-adversarial-routing",
      "command": [
        "{python}",
        "tests/run_adversarial_eval.py",
        "--codebuddy-cli",
        "{workbuddy_cli}",
        "--suite-zip",
        "{workbuddy_archive}",
        "--output-dir",
        "{gate_output}",
        "--workers",
        "1"
      ],
      "timeout_seconds": 14400
