    "two_step_installation_protocol": {
      "scope": "workbuddy_only",
      "phase_1_review": {
        "writes_allowed": false,
        "secret_included": false,
        "required_checks": [
          "确认宿主为 WorkBuddy 5 或更高版本",
          "确认 WorkBuddy 内置插件管理器可用",
          "核对包哈希、签名、联网范围、存储位置和回滚路径"
