  "release_gates": [
    {
      "name": "local-formal-skill-reconciliation",
      "command": [
        "{python}",
        "scripts/audit_local_formal_skill_drift.py",
        "--skills-root",
        "skills",
        "--local-root",
        "~/.codex/skills",
