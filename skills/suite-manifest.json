{
  "schema_version": 1,
  "product_name": "企业全生命周期助手",
  "product_slug": "jiaotang-skills",
  "install_mode": "bundle-only",
  "release": {
    "tag": "V1.4.1",
    "version": "1.4.1",
    "summary": "V1.4.1 增加已绑定 WorkBuddy 设备的跨版本升级事务，在不重新登记设备、不轮换密钥和访问凭据的前提下完成签名包升级、连接复核与失败回滚。",
    "changes": [
      "Skills 中心会比较已验收设备版本与最新 WorkBuddy 正式包，只在存在更高版本时显示跨版本升级按钮。",
      "升级采用审查与明确授权两步流程，固定源版本、源包哈希、目标版本、目标包哈希和原设备绑定，计划生成后不跟随后续发布漂移。",
      "升级复用现有设备标识、Ed25519 设备密钥、API Token、bootstrap_url 和 jiaotang-kb MCP 身份，不创建第二套登记或连接。",
      "目标包必须通过 SHA-256、Ed25519 签名和发布者指纹核验；只有目标版本、目标包哈希和 jiaotang-kb 只读连接复核全部一致，门户才更新设备版本。",
      "升级失败时恢复升级前插件目录并保留原设备身份和系统凭据；失败阶段会回传门户，频控、临时网络错误或验签失败不得冒充升级成功。",
      "设备绑定新增已安装版本、包哈希、安装时间和最近升级时间，历史安装结果与升级结果使用同一可审计状态面板。",
      "发布端使用带 Ed25519 签名哈希清单的全局单写租约，GitHub、知识门户和安装端必须属于同一发布事务；其他任务只能只读监控。",
      "49 项顶层 Skills 与 V1.4.0 业务规则保持不变；V1.4.0 已绑定设备升级 V1.4.1 时无需重新登记。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "新设备通过门户两步流程安装 V1.4.1 WorkBuddy 包；已绑定 V1.4.0 设备使用 Skills 中心升级按钮，审查并确认后由同一个 Agent 下载、验签、升级和复核，不重新登记。",
      "manual_fallback": "手工配置只作为自动两步流程的替代路径；核验签名包后，将一次性 bootstrap_url 填入 WorkBuddy 插件敏感配置。",
      "verification": "门户四阶段完成后还必须确认 jiaotang-kb 已进入当前运行时，成功调用任一只读状态或检索工具，并抽样验证项目算法、交付契约或专利案卷入口；之后升级验收才完成。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "已验证",
        "note": "适用于能够导入 SKILL.md 的 Agent。"
      },
      {
        "target": "macOS WorkBuddy",
        "status": "跨平台通用包",
        "note": "继续使用持久本地市场和签名插件清单内联 MCP；V1.4.0 已绑定设备通过两步升级事务升级 V1.4.1 时无需重新登记。"
      },
      {
        "target": "Windows WorkBuddy",
        "status": "结构兼容，待主人实机验收",
        "note": "V1.4.1 沿用无 .mcp.json 运行时依赖的跨平台结构，并通过包结构、签名与升级协议回归；真实 Windows 升级和重启继续由主人验收。"
      }
    ],
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "WorkBuddy 跨版本升级失败时优先恢复升级前插件目录和原版本包；不删除持久 jiaotang 市场、设备绑定、设备密钥、API Token、bootstrap_url 或 jiaotang-kb MCP 身份。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
