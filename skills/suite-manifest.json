{
  "schema_version": 1,
  "product_name": "企业全生命周期助手",
  "product_slug": "jiaotang-skills",
  "install_mode": "bundle-only",
  "release": {
    "tag": "V1.4.2",
    "version": "1.4.2",
    "summary": "V1.4.2 修复 WorkBuddy 5.3.5 的插件 MCP 注册与首次设备绑定兼容性，恢复真实工具枚举，并保留 V1.4.1 的跨版本升级事务。",
    "changes": [
      "按 WorkBuddy 5.3.5 的真实插件扫描规则恢复插件根目录 .mcp.json，并在 plugin.json 中保留相对路径声明；jiaotang-kb 现可被宿主注册和枚举。",
      "移除宿主未实现的第三方 userConfig 依赖；未绑定插件先仅暴露 jiaotang_kb_setup 与无敏感信息状态工具，通过本地 MCP 工具完成一次性设备绑定。",
      "setup 工具不回显 bootstrap_url，长期 API Token 和 Ed25519 私钥继续只保存到 macOS 登录钥匙串或 Windows 当前用户凭据管理器。",
      "绑定完成后在同一插件进程补做远端 MCP 初始化并发送 tools/list_changed 通知；若宿主未主动刷新，完全退出并重启 WorkBuddy 后直接加载远端 knowledge_search、knowledge_document 等真实工具。",
      "MCP stdio 代理改为串行处理 JSON-RPC 消息，避免 initialize、notifications/initialized 与 tools/list 并发转发造成会话竞争。",
      "V1.4.0 和 V1.4.1 已绑定设备升级 V1.4.2 时复用原设备标识、密钥和访问凭据，不重新登记；未绑定的 V1.4.1 安装可在升级后完成绑定。",
      "验收门禁改为实际 tools/list 必须包含远端检索工具，并成功调用 knowledge_service_status 或任一只读检索；通用资源读取器返回业务错误不再视为连接成功。",
      "49 项顶层 Skills 与 V1.4.1 业务规则保持不变。"
    ],
    "installation": {
      "generic": "支持 SKILL.md 的 Agent 使用通用 Skills 包，导入 skills 目录后启动首次配置向导。",
      "workbuddy": "新设备通过门户两步流程安装 V1.4.2 WorkBuddy 包；插件启用后由 Agent 调用本地 jiaotang_kb_setup 工具完成绑定。已绑定 V1.4.0 或 V1.4.1 设备使用 Skills 中心升级按钮，不重新登记。",
      "manual_fallback": "手工配置只作为自动两步流程的替代路径；核验签名包并启用插件后，仅将一次性 bootstrap_url 作为本地 jiaotang_kb_setup 工具参数。",
      "verification": "门户四阶段完成后还必须确认 jiaotang-kb 已进入当前运行时，成功调用任一只读状态或检索工具，并抽样验证项目算法、交付契约或专利案卷入口；之后升级验收才完成。"
    },
    "compatibility": [
      {
        "target": "通用 Skills",
        "status": "已验证",
        "note": "适用于能够导入 SKILL.md 的 Agent。"
      },
      {
        "target": "macOS WorkBuddy",
        "status": "跨平台通用包",
        "note": "V1.4.2 已按 WorkBuddy 5.3.5 实际扫描规则恢复插件根目录 .mcp.json，并使用本地 setup 工具完成首次绑定；既有已绑定设备无需重新登记。"
      },
      {
        "target": "Windows WorkBuddy",
        "status": "结构兼容，待主人实机验收",
        "note": "V1.4.2 将 .mcp.json、跨平台 Node 启动器和 setup 运行时全部纳入签名清单；真实 Windows 安装、绑定和重启继续由主人实机验收。"
      }
    ],
    "two_step_installation_protocol": {
      "scope": "workbuddy_only",
      "phase_1_review": {
        "writes_allowed": false,
        "secret_included": false,
        "required_checks": [
          "确认宿主为 WorkBuddy 5 或更高版本",
          "确认 WorkBuddy 内置插件管理器可用",
          "核对包哈希、签名、联网范围、存储位置和回滚路径"
        ],
        "non_workbuddy_action": "停留在审查阶段，不得下载或安装 WorkBuddy 插件包"
      },
      "phase_2_install": {
        "explicit_user_confirmation_required": true,
        "pin_reviewed_workbuddy_version_and_sha256": true,
        "dynamic_command_allowed": false,
        "success_gate": [
          "宿主完成原生注册",
          "设备凭据写入系统安全存储并回读",
          "tools/list 枚举真实远端工具",
          "只读工具实际调用成功",
          "门户四阶段状态完成"
        ]
      },
      "released_adapters": [
        "workbuddy"
      ]
    },
    "rollback": [
      "通用 Skills 回滚时恢复上一版本 skills 目录，并重新运行安装完整性检查。",
      "WorkBuddy 跨版本升级失败时优先恢复升级前插件目录和原版本包；不删除持久 jiaotang 市场、设备绑定、设备密钥、API Token 或 jiaotang-kb MCP 身份。",
      "回滚不得覆盖个人项目资料、本地政策规则、个人偏好或系统凭据。"
    ]
  },
