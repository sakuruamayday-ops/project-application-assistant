# Paths
PROJECT_ASSISTANT_SKILLS_DIR=/absolute/path/to/project-application-assistant/skills
PROJECT_ASSISTANT_RULES_DIR=/absolute/path/to/project-application-assistant/project-rules
PROJECT_ASSISTANT_CACHE_DIR=/absolute/path/to/project-application-assistant/cache
PROJECT_ASSISTANT_LOGS_DIR=/absolute/path/to/project-application-assistant/logs
PROJECT_ASSISTANT_USER_GUIDE_PATH=/absolute/path/to/project-application-assistant/用户使用指南.md

# Platform homes
CODEX_HOME=/absolute/path/to/.codex

# Model providers
OPENAI_API_KEY=replace_with_your_own_key
ANTHROPIC_API_KEY=replace_with_your_own_key

# Enterprise and policy providers
QCC_MCP_TOKEN=replace_with_your_own_token
PADDLE_OCR_API_KEY=replace_only_when_using_cloud_ocr
AIQICE_USERNAME=replace_with_your_own_account
AIQICE_PASSWORD=replace_with_your_own_password

# Feishu
FEISHU_APP_ID=replace_with_your_own_app_id
FEISHU_APP_SECRET=replace_with_your_own_app_secret
