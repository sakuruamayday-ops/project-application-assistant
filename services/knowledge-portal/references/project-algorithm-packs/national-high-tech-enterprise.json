    {
      "rule_id": "hte-innovation-evaluation",
      "type": "hard-threshold",
      "field": "high_tech_innovation_score",
      "operator": "gt",
      "expected": 70,
      "unit": "分",
      "source": "《高新技术企业认定管理工作指引》国科发火〔2016〕195号",
      "source_quote": "企业创新能力主要从知识产权、科技成果转化能力、研究开发组织管理水平、企业成长性等四项指标进行评价；综合得分达到70分以上（不含70分）为符合认定要求。",
      "policy_status": "current",
      "review_status": "confirmed",
      "approved_by": "主人授权；焦糖按科技部现行原文核验",
      "approved_at": "2026-07-27 16:30:00",
      "source_url": "https://www.most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2016/201602/t20160205_123998.html"
