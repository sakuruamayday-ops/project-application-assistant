      "unit": "%",
      "source": "国科发火〔2016〕32号第十一条",
      "source_quote": "科技人员占当年职工总数的比例不低于百分之十。",
      "policy_status": "current",
      "review_status": "confirmed",
      "approved_by": "主人授权；焦糖按科技部现行原文核验",
      "approved_at": "2026-07-27 16:30:00",
      "source_url": "https://www.most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2016/201602/t20160205_123998.html"
    },
    {
