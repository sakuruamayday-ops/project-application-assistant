          "rule_id": "hte-core-ip-main-product-support",
          "field": "core_ip_supports_main_product",
          "operator": "truthy",
          "expected": true
        }
      ],
      "source": "国科发火〔2016〕32号第十一条及国科发火〔2016〕195号",
      "source_quote": "企业通过自主研发、受让、受赠、并购等方式，获得对其主要产品服务在技术上发挥核心支持作用的知识产权的所有权；知识产权须在中国境内授权或审批审定并在有效保护期内。",
      "policy_status": "current",
      "review_status": "confirmed",
      "approved_by": "主人授权；焦糖按科技部现行原文核验",
      "approved_at": "2026-07-27 16:30:00",
      "source_url": "https://www.most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2016/201602/t20160205_123998.html"
    },
    {
      "rule_id": "hte-field-match",
      "type": "hard-threshold",
      "field": "high_tech_field_match",
      "operator": "truthy",
      "expected": true,
      "source": "国科发火〔2016〕32号第十一条",
      "source_quote": "核心技术属于国家重点支持的高新技术领域。",
      "policy_status": "current",
      "review_status": "confirmed",
      "approved_by": "主人授权；焦糖按科技部现行原文核验",
      "approved_at": "2026-07-27 16:30:00",
      "source_url": "https://www.most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2016/201602/t20160205_123998.html"
    },
    {
      "rule_id": "hte-technology-personnel-ratio",
      "type": "hard-threshold",
      "field": "technology_personnel_ratio",
      "operator": "gte",
