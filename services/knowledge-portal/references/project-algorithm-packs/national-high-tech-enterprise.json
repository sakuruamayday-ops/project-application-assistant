      "rule_id": "hte-high-tech-revenue",
      "type": "hard-threshold",
      "field": "high_tech_revenue_ratio",
      "operator": "gte",
      "expected": 60,
      "unit": "%",
      "source": "国科发火〔2016〕32号第十一条",
      "source_quote": "高新技术产品或服务收入占同期总收入的比例不低于百分之六十。",
      "policy_status": "current",
      "review_status": "confirmed",
      "approved_by": "主人授权；焦糖按科技部现行原文核验",
