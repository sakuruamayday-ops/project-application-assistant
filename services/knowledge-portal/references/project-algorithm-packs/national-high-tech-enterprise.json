              "field": "latest_sales_revenue",
              "operator": "gt",
              "expected": 5000,
              "unit": "万元"
            },
            {
              "rule_id": "hte-rnd-tier-middle-ceiling",
              "field": "latest_sales_revenue",
              "operator": "lte",
              "expected": 20000,
              "unit": "万元"
            },
            {
              "rule_id": "hte-rnd-tier-middle-ratio",
              "field": "rd_expense_ratio",
              "operator": "gte",
              "expected": 4,
              "unit": "%"
            }
          ]
        },
        {
          "rule_id": "hte-rnd-tier-high",
          "logic": "all",
          "children": [
            {
              "rule_id": "hte-rnd-tier-high-revenue",
              "field": "latest_sales_revenue",
              "operator": "gt",
              "expected": 20000,
              "unit": "万元"
            },
            {
              "rule_id": "hte-rnd-tier-high-ratio",
              "field": "rd_expense_ratio",
              "operator": "gte",
              "expected": 3,
              "unit": "%"
            }
          ]
        }
      ],
      "source": "国科发火〔2016〕32号第十一条",
      "source_quote": "最近一年销售收入不超过5000万元的研发费用比例不低于5%；5000万元至2亿元的不低于4%；2亿元以上的不低于3%。",
      "policy_status": "current",
      "review_status": "confirmed",
      "approved_by": "主人授权；焦糖按科技部现行原文核验",
