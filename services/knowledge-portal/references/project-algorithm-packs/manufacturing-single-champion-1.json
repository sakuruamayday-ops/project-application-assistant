      ],
      "value_type": "boolean",
      "derivation_requirements": [
        "申请产品市场占有率位居全球前5或全国前3。"
      ]
    },
    {
      "field": "zj_single_champion_revenue_branch_met",
      "label": "主营收入分支",
      "aliases": [
        "主营收入分支"
      ],
      "value_type": "boolean",
      "derivation_requirements": [
        "近三年其中一年主营业务收入原则上达到4亿元；有效小巨人、山区海岛县及特定排名或历史经典产业适用豁免或降低分支。"
      ]
    },
    {
      "field": "zj_single_champion_innovation_met",
      "label": "创新能力",
      "aliases": [
        "创新能力"
      ],
      "value_type": "boolean",
      "derivation_requirements": [
        "原则上具有省级以上研发平台，研发强度达到3%或行业领先，并拥有实际应用、产生效益的核心知识产权和标准成果。"
      ]
    },
    {
      "field": "zj_single_champion_quality_energy_met",
      "label": "质量性能能耗",
      "aliases": [
        "质量性能能耗"
      ],
      "value_type": "boolean",
      "derivation_requirements": [
        "产品质量、工艺和关键性能国内领先，能耗达到行业先进值，绿色低碳水平较高。"
      ]
    },
    {
      "field": "zj_single_champion_management_met",
      "label": "经营管理和国际化",
      "aliases": [
        "经营管理和国际化"
      ],
      "value_type": "boolean",
      "derivation_requirements": [
        "盈利、精益管理、数字化、人才、品牌和国际化能力应符合管理办法。"
      ]
    },
    {
      "field": "zj_single_champion_compliance_clear",
      "label": "近三年合规",
      "aliases": [
        "近三年合规"
      ],
      "value_type": "boolean",
      "derivation_requirements": [
