      "label": "专业化年限分支",
      "aliases": [
        "专业化年限分支"
      ],
      "value_type": "boolean",
      "derivation_requirements": [
        "一般产品从事相关领域6年以上、新产品3年以上；山区海岛县一般产品5年以上、新产品2年以上。"
      ]
    },
    {
      "field": "zj_single_champion_market_rank_met",
      "label": "市场占有率排名",
