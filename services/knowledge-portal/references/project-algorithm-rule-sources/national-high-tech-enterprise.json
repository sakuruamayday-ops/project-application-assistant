  ],
  "rules": [
    {"rule_id": "hte-registration-years", "type": "hard-threshold", "field": "registration_days", "operator": "gte", "expected": 365, "unit": "天", "source": "《高新技术企业认定管理工作指引》国科发火〔2016〕195号", "source_quote": "注册成立一年以上是指企业须注册成立365个日历天数以上。"},
    {"rule_id": "hte-core-ip-support", "type": "hard-threshold", "field": "core_ip_support_met", "operator": "truthy", "expected": true, "source": "国科发火〔2016〕32号第十一条及国科发火〔2016〕195号", "source_quote": "企业通过自主研发、受让、受赠、并购等方式，获得对其主要产品服务在技术上发挥核心支持作用的知识产权的所有权；知识产权须在中国境内授权或审批审定并在有效保护期内。"},
    {"rule_id": "hte-field-match", "type": "hard-threshold", "field": "high_tech_field_match", "operator": "truthy", "expected": true, "source": "国科发火〔2016〕32号第十一条", "source_quote": "核心技术属于国家重点支持的高新技术领域。"},
    {"rule_id": "hte-technology-personnel-ratio", "type": "hard-threshold", "field": "technology_personnel_ratio", "operator": "gte", "expected": 10, "unit": "%", "source": "国科发火〔2016〕32号第十一条", "source_quote": "科技人员占当年职工总数的比例不低于百分之十。"},
    {"rule_id": "hte-rnd-tier", "type": "hard-threshold", "field": "rnd_ratio_tier_requirement_met", "operator": "truthy", "expected": true, "source": "国科发火〔2016〕32号第十一条", "source_quote": "研发费用比例须达到与最近一年销售收入对应的分档要求。"},
    {"rule_id": "hte-domestic-rnd", "type": "hard-threshold", "field": "domestic_rnd_ratio", "operator": "gte", "expected": 60, "unit": "%", "source": "国科发火〔2016〕32号第十一条", "source_quote": "境内研发费用占全部研发费用的比例不低于百分之六十。"},
    {"rule_id": "hte-high-tech-revenue", "type": "hard-threshold", "field": "high_tech_revenue_ratio", "operator": "gte", "expected": 60, "unit": "%", "source": "国科发火〔2016〕32号第十一条", "source_quote": "高新技术产品或服务收入占同期总收入的比例不低于百分之六十。"},
    {"rule_id": "hte-innovation-evaluation", "type": "hard-threshold", "field": "high_tech_innovation_score", "operator": "gt", "expected": 70, "unit": "分", "source": "《高新技术企业认定管理工作指引》国科发火〔2016〕195号", "source_quote": "企业创新能力主要从知识产权、科技成果转化能力、研究开发组织管理水平、企业成长性等四项指标进行评价；综合得分达到70分以上（不含70分）为符合认定要求。"},
    {"rule_id": "hte-compliance", "type": "hard-threshold", "field": "no_major_incident", "operator": "truthy", "expected": true, "source": "国科发火〔2016〕32号第十一条", "source_quote": "申请认定前一年内不得发生规定的重大事故或严重环境违法行为。"}
  ],
