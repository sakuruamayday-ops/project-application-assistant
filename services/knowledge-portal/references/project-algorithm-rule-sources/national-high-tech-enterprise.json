  "rules": [
    {"rule_id": "hte-registration-years", "type": "hard-threshold", "field": "registration_years", "operator": "gte", "expected": 1, "unit": "年", "source": "《高新技术企业认定管理办法》国科发火〔2016〕32号第十一条", "source_quote": "申请认定时须注册成立一年以上。"},
