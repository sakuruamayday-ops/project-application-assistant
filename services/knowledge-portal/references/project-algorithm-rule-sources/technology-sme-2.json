  "rules": [
    {"rule_id": "technology-sme-resident-enterprise", "type": "hard-threshold", "field": "china_resident_enterprise", "operator": "truthy", "expected": true, "source": "《科技型中小企业评价办法》国科发政〔2017〕115号及2026年度评价通知", "source_quote": "申请主体应为在中国境内注册的居民企业。"},
    {"rule_id": "technology-sme-employees", "type": "hard-threshold", "field": "employee_count", "operator": "lte", "expected": 500, "unit": "人", "source": "国科发政〔2017〕115号", "source_quote": "职工总数不超过五百人。"},
    {"rule_id": "technology-sme-revenue", "type": "hard-threshold", "field": "revenue", "operator": "lte", "expected": 20000, "unit": "万元", "source": "国科发政〔2017〕115号", "source_quote": "年销售收入不超过二亿元。"},
    {"rule_id": "technology-sme-assets", "type": "hard-threshold", "field": "total_assets", "operator": "lte", "expected": 20000, "unit": "万元", "source": "国科发政〔2017〕115号", "source_quote": "资产总额不超过二亿元。"},
    {"rule_id": "technology-sme-product-policy", "type": "hard-threshold", "field": "product_policy_compliant", "operator": "truthy", "expected": true, "source": "国科发政〔2017〕115号", "source_quote": "产品和服务不得属于国家规定的禁止、限制和淘汰类。"},
    {"rule_id": "technology-sme-compliance", "type": "hard-threshold", "field": "no_major_incident", "operator": "truthy", "expected": true, "source": "国科发政〔2017〕115号", "source_quote": "规定期间内不得发生重大事故、严重环境违法或科研严重失信行为。"},
    {"rule_id": "technology-sme-registry-status", "type": "hard-threshold", "field": "not_abnormal_or_seriously_dishonest", "operator": "truthy", "expected": true, "source": "国科发政〔2017〕115号", "source_quote": "企业不得列入经营异常名录和严重违法失信企业名单。"},
    {"rule_id": "technology-sme-score-or-direct", "type": "hard-threshold", "field": "score_or_direct_confirmation_met", "operator": "truthy", "expected": true, "source": "国科发政〔2017〕115号", "source_quote": "须满足综合评价得分要求或规定的直接确认条件。"}
