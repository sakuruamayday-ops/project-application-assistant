    {"rule_id": "specialized-sme-market-years", "type": "hard-threshold", "field": "market_years", "operator": "gte", "expected": 3, "unit": "年", "source": "工信部企业〔2026〕2号", "source_quote": "截至上年末从事特定细分市场满三年。"},
    {"rule_id": "specialized-sme-revenue-or-investment", "type": "hard-threshold", "field": "revenue_or_equity_investment_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "营业收入或合格机构投资者实缴股权投资须满足规定条件。"},
    {"rule_id": "specialized-sme-main-business-ratio", "type": "hard-threshold", "field": "main_business_revenue_ratio", "operator": "gte", "expected": 80, "unit": "%", "source": "工信部企业〔2026〕2号", "source_quote": "主营业务收入占营业收入比重不低于百分之八十。"},
    {"rule_id": "specialized-sme-liability-ratio", "type": "hard-threshold", "field": "asset_liability_ratio", "operator": "lte", "expected": 80, "unit": "%", "source": "工信部企业〔2026〕2号", "source_quote": "资产负债率不超过百分之八十。"},
    {"rule_id": "specialized-sme-rnd", "type": "hard-threshold", "field": "rnd_each_year_requirement_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "近两年研发费用和研发强度须逐年达到规定标准。"},
    {"rule_id": "specialized-sme-ip", "type": "hard-threshold", "field": "ip_or_exemption_requirement_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "须满足主导产品相关知识产权要求或规定的豁免条件。"},
    {"rule_id": "specialized-sme-market-influence", "type": "hard-threshold", "field": "market_influence_requirement_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "主导产品细分市场占有率应较为靠前并具有一定影响力。"},
    {"rule_id": "specialized-sme-quality-score", "type": "hard-threshold", "field": "specialized_quality_score", "operator": "gte", "expected": 50, "unit": "分", "source": "工信部企业〔2026〕2号", "source_quote": "当年度专精特新发展质量评价得分达到五十分以上。"},
    {"rule_id": "specialized-sme-leading-product-ratio", "type": "hard-threshold", "field": "leading_product_revenue_ratio", "operator": "gt", "expected": 50, "unit": "%", "source": "工信部企业〔2026〕2号", "source_quote": "主导产品收入占同期营业收入比重超过百分之五十。"}
