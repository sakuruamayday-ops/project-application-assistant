  "rules": [
    {
      "rule_id": "specialized-sme-entry-status",
      "logic": "all",
      "children": [
        {
          "rule_id": "specialized-sme-technology-status",
          "field": "technology_sme_status",
          "operator": "truthy",
          "expected": true
        },
        {
          "rule_id": "specialized-sme-innovative-status",
          "field": "innovative_sme_status",
          "operator": "truthy",
          "expected": true
        }
      ],
      "type": "hard-threshold",
      "source": "《优质中小企业梯度培育管理办法》工信部企业〔2026〕2号",
      "source_quote": "须满足科技型和创新型中小企业相关资格要求。"
    },
    {
      "rule_id": "specialized-sme-market-years",
      "type": "hard-threshold",
      "field": "market_years",
      "operator": "gte",
      "expected": 3,
      "unit": "年",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "截至上年末从事特定细分市场满三年。"
    },
    {
      "rule_id": "specialized-sme-revenue-or-investment",
      "logic": "any",
      "children": [
        {
          "rule_id": "specialized-sme-revenue",
          "field": "revenue",
          "operator": "gte",
          "expected": 1500,
          "unit": "万元"
        },
        {
          "rule_id": "specialized-sme-equity-investment",
          "field": "qualified_equity_investment_two_years",
          "operator": "gte",
          "expected": 2000,
          "unit": "万元"
        }
      ],
      "type": "hard-threshold",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "营业收入或合格机构投资者实缴股权投资须满足规定条件。"
    },
    {
      "rule_id": "specialized-sme-main-business-ratio",
      "type": "hard-threshold",
      "field": "main_business_revenue_ratio",
      "operator": "gte",
      "expected": 80,
      "unit": "%",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "主营业务收入占营业收入比重不低于百分之八十。"
    },
    {
      "rule_id": "specialized-sme-liability-ratio",
      "type": "hard-threshold",
      "field": "asset_liability_ratio",
      "operator": "lte",
      "expected": 80,
      "unit": "%",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "资产负债率不超过百分之八十。"
    },
    {
      "rule_id": "specialized-sme-rnd",
      "field": "specialized_sme_two_year_rd_assessment_passed",
      "operator": "truthy",
      "expected": true,
      "type": "hard-threshold",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "近两年研发费用和研发强度须逐年达到规定标准。"
    },
    {
      "rule_id": "specialized-sme-ip",
      "logic": "any",
      "children": [
        {
          "rule_id": "specialized-sme-ip-general",
          "logic": "all",
          "children": [
            {
              "rule_id": "specialized-sme-ip-count",
              "field": "specialized_sme_relevant_class_i_ip_count",
              "operator": "gte",
              "expected": 1,
              "unit": "项"
            },
            {
              "rule_id": "specialized-sme-ip-applied",
              "field": "specialized_sme_class_i_ip_applied",
              "operator": "truthy",
              "expected": true
            },
            {
              "rule_id": "specialized-sme-ip-benefit",
              "field": "specialized_sme_class_i_ip_economic_benefit",
              "operator": "truthy",
              "expected": true
            }
          ]
        },
        {
          "rule_id": "specialized-sme-ip-exemption",
          "field": "specialized_sme_ip_exemption_route_confirmed",
          "operator": "truthy",
          "expected": true
        }
      ],
      "type": "hard-threshold",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "须满足主导产品相关知识产权要求或规定的豁免条件。"
    },
    {
      "rule_id": "specialized-sme-market-influence",
      "field": "specialized_sme_market_influence_assessment_passed",
      "operator": "truthy",
      "expected": true,
      "type": "hard-threshold",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "主导产品细分市场占有率应较为靠前并具有一定影响力。"
    },
    {
      "rule_id": "specialized-sme-quality-score",
      "type": "hard-threshold",
      "field": "specialized_quality_score",
      "operator": "gte",
      "expected": 50,
      "unit": "分",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "当年度专精特新发展质量评价得分达到五十分以上。"
    },
    {
      "rule_id": "specialized-sme-leading-product-ratio",
      "type": "hard-threshold",
      "field": "leading_product_revenue_ratio",
      "operator": "gt",
      "expected": 50,
      "unit": "%",
      "source": "工信部企业〔2026〕2号",
      "source_quote": "主导产品收入占同期营业收入比重超过百分之五十。"
    }
  ],
