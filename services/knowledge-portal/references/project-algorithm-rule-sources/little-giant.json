  "rules": [
    {"rule_id": "little-giant-specialized-sme-status", "type": "hard-threshold", "field": "specialized_sme_status", "operator": "truthy", "expected": true, "source": "《优质中小企业梯度培育管理办法》工信部企业〔2026〕2号", "source_quote": "申请企业须已获得专精特新中小企业称号。"},
    {"rule_id": "little-giant-market-years", "type": "hard-threshold", "field": "market_years", "operator": "gte", "expected": 3, "unit": "年", "source": "工信部企业〔2026〕2号", "source_quote": "截至上年末从事特定细分市场满三年。"},
    {"rule_id": "little-giant-revenue", "type": "hard-threshold", "field": "revenue", "operator": "gte", "expected": 5000, "unit": "万元", "source": "工信部企业〔2026〕2号", "source_quote": "上年度营业收入达到五千万元以上。"},
    {"rule_id": "little-giant-main-business-ratio", "type": "hard-threshold", "field": "main_business_revenue_ratio", "operator": "gte", "expected": 90, "unit": "%", "source": "工信部企业〔2026〕2号", "source_quote": "主营业务收入占营业收入比重不低于百分之九十。"},
    {"rule_id": "little-giant-revenue-cagr", "type": "hard-threshold", "field": "two_year_revenue_cagr", "operator": "gte", "expected": 5, "unit": "%", "source": "工信部企业〔2026〕2号", "source_quote": "近两年营业收入复合增长率不低于百分之五。"},
    {"rule_id": "little-giant-liability-ratio", "type": "hard-threshold", "field": "asset_liability_ratio", "operator": "lte", "expected": 75, "unit": "%", "source": "工信部企业〔2026〕2号", "source_quote": "资产负债率不超过百分之七十五。"},
    {"rule_id": "little-giant-rnd", "type": "hard-threshold", "field": "little_giant_rnd_requirement_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "近两年研发费用合计和逐年研发强度须达到规定标准。"},
    {"rule_id": "little-giant-ip", "type": "hard-threshold", "field": "little_giant_ip_or_exemption_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "须满足主导产品相关Ⅰ类知识产权要求或规定的豁免条件。"},
    {"rule_id": "little-giant-market-share", "type": "hard-threshold", "field": "market_share_requirement_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "主导产品市场占有率须达到规定比例或国内排名要求。"},
    {"rule_id": "little-giant-industry-chain", "type": "hard-threshold", "field": "industry_chain_key_link_met", "operator": "truthy", "expected": true, "source": "工信部企业〔2026〕2号", "source_quote": "主导产品应位于规定产业链关键环节并发挥重要作用。"},
    {"rule_id": "little-giant-quality-score", "type": "hard-threshold", "field": "specialized_quality_score", "operator": "gte", "expected": 60, "unit": "分", "source": "工信部企业〔2026〕2号", "source_quote": "当年度专精特新发展质量评价得分达到六十分以上。"},
    {"rule_id": "little-giant-leading-product-ratio", "type": "hard-threshold", "field": "leading_product_revenue_ratio", "operator": "gt", "expected": 50, "unit": "%", "source": "工信部企业〔2026〕2号", "source_quote": "主导产品收入占同期营业收入比重超过百分之五十。"}
  ]
