              "field": "hz_rd_above_scale_industrial_enterprise",
              "operator": "truthy",
              "expected": true
            }
          ]
        }
      ],
      "type": "hard-threshold",
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "本市注册，且为市级以上科技型企业、高新技术企业或规上工业企业。"
    },
    {
      "rule_id": "hz-rd-staff",
      "logic": "any",
      "children": [
        {
          "rule_id": "hz-rd-staff-software",
          "logic": "all",
          "children": [
            {
              "rule_id": "hz-rd-software-type",
              "field": "hz_rd_is_software_enterprise",
              "operator": "truthy",
              "expected": true
            },
            {
              "rule_id": "hz-rd-software-staff",
              "field": "hz_rd_full_time_research_staff",
              "operator": "gte",
              "expected": 15,
              "unit": "人"
            }
          ]
        },
        {
          "rule_id": "hz-rd-staff-general",
          "logic": "all",
          "children": [
            {
              "rule_id": "hz-rd-nonsoftware-type",
              "field": "hz_rd_is_software_enterprise",
              "operator": "falsy",
              "expected": false
            },
            {
              "rule_id": "hz-rd-general-staff",
              "field": "hz_rd_full_time_research_staff",
              "operator": "gte",
              "expected": 10,
              "unit": "人"
            }
          ]
        }
      ],
      "type": "hard-threshold",
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "专职从事研发活动人员一般10人以上；软件企业15人以上，须按企业类型选择对应分支。"
    },
    {
      "rule_id": "hz-rd-site",
      "type": "hard-threshold",
      "field": "hz_rd_site_area",
      "operator": "gt",
      "expected": 200,
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "科研场地相对集中，面积200平方米以上。",
      "unit": "平方米"
    },
    {
      "rule_id": "hz-rd-equipment",
      "field": "hz_rd_applicable_equipment_threshold_assessment_passed",
      "operator": "truthy",
      "expected": true,
      "type": "hard-threshold",
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "专用科研设备原值一般200万元以上；软件、农业企业及软件企业50人以上研发队伍适用相应降低分支。"
    },
    {
      "rule_id": "hz-rd-investment",
      "logic": "any",
      "children": [
        {
          "rule_id": "hz-rd-investment-amount",
          "field": "hz_rd_self_funded_expense",
          "operator": "gte",
          "expected": 200,
          "unit": "万元"
        },
        {
          "rule_id": "hz-rd-investment-ratio",
          "field": "hz_rd_self_funded_expense_ratio",
          "operator": "gte",
          "expected": 3,
          "unit": "%"
        }
      ],
      "type": "hard-threshold",
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "上一年度研发费用自筹投入200万元以上，或占销售收入3%以上。"
    },
    {
      "rule_id": "hz-rd-projects",
      "logic": "any",
      "children": [
        {
          "rule_id": "hz-rd-municipal-projects",
          "field": "hz_rd_municipal_or_above_project_count",
          "operator": "gte",
          "expected": 1,
          "unit": "项"
        },
        {
          "rule_id": "hz-rd-self-projects",
          "field": "hz_rd_self_innovation_project_count",
          "operator": "gte",
          "expected": 3,
          "unit": "项"
        }
      ],
      "type": "hard-threshold",
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "获市级以上科研项目1项以上，或企业自主立项技术创新项目3项以上。"
    },
    {
      "rule_id": "hz-rd-ip",
      "logic": "any",
      "children": [
        {
          "rule_id": "hz-rd-class-i-ip",
          "field": "hz_rd_class_i_ip_count",
          "operator": "gte",
          "expected": 1,
          "unit": "项"
        },
        {
          "rule_id": "hz-rd-other-ip",
          "field": "hz_rd_other_ip_count",
          "operator": "gte",
          "expected": 3,
          "unit": "项"
        }
      ],
      "type": "hard-threshold",
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "取得发明专利等I类成果1项以上，或实用新型、外观设计、软件著作权等3项以上。"
    },
    {
      "rule_id": "hz-rd-accounting",
      "type": "hard-threshold",
      "field": "hz_rd_independent_accounting",
      "operator": "truthy",
      "expected": true,
      "source": "《杭州市企业高新技术研究开发中心管理办法》",
      "source_quote": "研发活动应单独建账核算，规章制度健全。"
    },
    {
      "rule_id": "hz-rd-compliance",
      "type": "hard-threshold",
      "field": "hz_rd_compliance_clear",
      "operator": "truthy",
      "expected": true,
