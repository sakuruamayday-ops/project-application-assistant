                  "operator": "gte",
                  "expected": 4,
                  "unit": "%"
                },
                {
                  "rule_id": "zj-institute-rnd-middle-expense",
                  "field": "rnd_expense",
                  "operator": "gte",
                  "expected": 250,
                  "unit": "万元"
                }
              ]
            }
          ]
        },
        {
          "rule_id": "zj-institute-rnd-high-revenue",
          "logic": "all",
          "children": [
            {
              "rule_id": "zj-institute-rnd-high-floor",
              "field": "revenue",
              "operator": "gte",
              "expected": 20000,
              "unit": "万元"
            },
            {
              "rule_id": "zj-institute-rnd-high-route",
              "logic": "any",
              "children": [
                {
                  "rule_id": "zj-institute-rnd-high-ratio",
                  "field": "rnd_ratio",
                  "operator": "gte",
                  "expected": 3,
                  "unit": "%"
                },
                {
                  "rule_id": "zj-institute-rnd-high-expense",
                  "field": "rnd_expense",
                  "operator": "gte",
                  "expected": 800,
                  "unit": "万元"
                }
              ]
            }
          ]
        }
      ],
      "source": "浙经信高新〔2025〕169号第九条",
      "source_quote": "营业收入5000万元以下的，研发强度不低于5%且研发费用不低于100万元；5000万元至2亿元的，研发强度不低于4%或研发费用不低于250万元；2亿元以上的，研发强度不低于3%或研发费用不低于800万元。"
    },
