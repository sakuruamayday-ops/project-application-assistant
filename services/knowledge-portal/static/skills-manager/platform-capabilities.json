          "Authenticode code-signing certificate",
          "timestamped signature",
          "SmartScreen reputation validation"
        ]
      }
    }
  },
  "directory_sync": {
    "required_browser_capabilities": [
      "secureContext",
      "webCrypto",
      "directoryPicker",
      "directoryRemove",
      "zipDeflate"
    ],
