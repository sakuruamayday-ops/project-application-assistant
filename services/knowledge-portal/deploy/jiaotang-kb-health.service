[Unit]
Description=Check Jiaotang knowledge portal health
After=jiaotang-kb.service
OnFailure=jiaotang-kb-failure-report@%n.service jiaotang-kb-health-recovery@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/jiaotang-kb-app.env
ExecStart=/usr/local/sbin/jiaotang-kb-healthcheck
User=jiaotang
Group=jiaotang
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiaotang-kb
NoNewPrivileges=true
