[Unit]
Description=Check Jiaotang knowledge portal health
After=jiaotang-kb.service

[Service]
Type=oneshot
EnvironmentFile=/etc/jiaotang-kb.env
ExecStart=/usr/local/sbin/jiaotang-kb-healthcheck
User=jiaotang
Group=jiaotang
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiaotang-kb
NoNewPrivileges=true
