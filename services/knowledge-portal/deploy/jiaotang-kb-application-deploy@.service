[Unit]
Description=Run resumable Jiaotang application deployment %i
After=network-online.target
Wants=network-online.target
OnFailure=jiaotang-kb-failure-report@%n.service

[Service]
Type=oneshot
User=root
Group=root
TimeoutStartSec=7min
ExecStart=/usr/bin/python3 /usr/local/libexec/jiaotang-kb-application-deploy --deployment-id %i
Environment=JIAOTANG_RELEASE_TRASH_ROOT=/var/lib/jiaotang-kb/release-trash/files
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The transaction replaces both environment files atomically.  Rename needs
# write access to their parent directory, not only the existing file inodes.
ReadWritePaths=/etc /opt/jiaotang-kb-runtime /opt/jiaotang-kb-release-slots /var/lib/jiaotang-kb /srv/jiaotang/knowledge-index /run/lock
