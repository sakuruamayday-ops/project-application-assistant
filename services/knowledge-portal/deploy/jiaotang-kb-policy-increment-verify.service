[Unit]
Description=Verify Jiaotang signed weekly policy increment chain
After=network-online.target
Wants=network-online.target
OnFailure=jiaotang-kb-failure-report@%n.service

[Service]
Type=oneshot
TimeoutStartSec=15min
EnvironmentFile=/etc/jiaotang-kb-ops.env
ExecStart=/opt/jiaotang-kb-runtime/current/.venv/bin/python /usr/local/libexec/jiaotang-policy-increment-verify
User=root
Group=jiaotang
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/jiaotang-kb/policy-increment-public.pem
ReadWritePaths=/var/lib/jiaotang-kb /srv/jiaotang/knowledge-index
NoNewPrivileges=true
