[Unit]
Description=Incrementally sync Jiaotang production knowledge to OSS
After=network-online.target jiaotang-kb.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/jiaotang-kb.env
ExecStart=/usr/local/sbin/jiaotang-kb-oss-sync
User=root
Group=root
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiaotang-kb /var/backups/jiaotang-kb /srv/jiaotang/index-snapshots
NoNewPrivileges=true
