{
  "name": "jiaotang-skills-manager",
  "version": "0.2.0",
  "private": true,
  "description": "企业全生命周期助手跨平台 Skills 管理器",
  "main": "electron/main.cjs",
  "author": "焦糖",
  "license": "UNLICENSED",
  "scripts": {
    "catalog": "node scripts/build-skill-catalog.mjs",
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-app.mjs",
    "release:verify": "node scripts/release-security-check.mjs",
    "release:verify:unsigned-local": "node scripts/release-security-check.mjs --mode unsigned-local-authorization",
    "package:mac": "npm run catalog && electron-builder --mac dmg --arm64 --x64",
    "package:win": "npm run catalog && electron-builder --win nsis --x64",
    "package:mac:unsigned-local": "npm run catalog && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.unsigned-local.cjs --mac dmg --arm64 --x64",
    "package:win:unsigned-local": "npm run catalog && electron-builder --config electron-builder.unsigned-local.cjs --win nsis --x64",
    "package:unsigned-local": "npm run package:mac:unsigned-local && npm run package:win:unsigned-local"
  },
  "dependencies": {
    "adm-zip": "0.6.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.zshjiaotang.skills-manager",
    "productName": "焦糖 Skills 管理器",
    "artifactName": "Jiaotang-Skills-Manager-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "core/**/*",
      "electron/**/*",
      "renderer/**/*",
      "config/**/*",
      "data/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": true,
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
