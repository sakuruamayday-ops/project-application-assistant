{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy freshness manifest",
  "type": "object",
  "required": ["schema_version", "as_of_timezone", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "as_of_timezone": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "verified_at",
          "effective_from",
          "effective_until",
          "next_review_at",
          "source_locator",
          "source_sha256",
          "block_after_next_review"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "verified_at": {"type": "string", "format": "date"},
          "effective_from": {"type": ["string", "null"], "format": "date"},
          "effective_until": {"type": ["string", "null"], "format": "date"},
          "next_review_at": {"type": "string", "format": "date"},
          "source_locator": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "block_after_next_review": {"type": "boolean"}
        }
      }
    }
  }
}
